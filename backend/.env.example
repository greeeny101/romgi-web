# Copy to .env and fill in real values. Never commit .env.
#
# IMPORTANT if you use Docker Compose: it interpolates every value in this
# file (not just docker-compose.yml itself), and Django's auto-generated
# secrets can contain a literal `$` (get_random_secret_key()'s charset
# includes it). An unescaped `$word` gets silently treated as a variable
# reference and stripped out — Compose prints
# `The "word" variable is not set. Defaulting to a blank string.` and the
# container ends up with a corrupted/truncated value, no error raised.
# Escape any literal `$` in a value here as `$$` to avoid this (e.g. a key
# ending up as `...af$Kq9...` must be written as `...af$$Kq9...`).
# Running Django directly on the host (not via Compose) instead, this file
# is read by django-environ, which does NOT unescape `$$` — it's read
# literally, so that same key becomes `...af$$Kq9...` there. Harmless
# either way (still a valid, equally random secret), just not byte-identical
# between the two setups — not that it needs to be, they're separate runs.
DJANGO_SETTINGS_MODULE=config.settings.development

# django-environ generates one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Remember to escape any `$` in the result as `$$` — see note above.
SECRET_KEY=change-me

# Fernet key for encrypting per-user credentials at rest (IA session, debrid/metadata API keys).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me

# "django" is the Docker Compose service hostname — needed so the ingestion
# pipeline's internal NOPAYSTATION_KEYS_BASE_URL (http://django:8000, used
# by the download pipeline running in a celery-worker container) doesn't
# get rejected by Django's Host-header check.
ALLOWED_HOSTS=localhost,127.0.0.1,django
CORS_ALLOWED_ORIGINS=http://localhost:5173

# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://romgi:romgi@localhost:5432/romgi

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CHANNELS_REDIS_URL=redis://localhost:6379/2

QBITTORRENT_HOST=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin
# Path as seen INSIDE the qbittorrent container/host (docker-compose mounts
# the shared torrent_data volume there at /downloads) — distinct from
# TORRENT_WORKING_DIR, which is the same volume as seen by Django/Celery.
QBITTORRENT_SAVE_PATH=/downloads

STAGED_FILE_RETENTION_HOURS=24
STAGED_FILE_UNCLAIMED_DAYS=7
STAGED_FILES_DIR=./data/staged
TORRENT_WORKING_DIR=./data/torrents

CATALOG_BUILD_RETENTION=2

# Where the NoPayStation ingestion source writes generated RAP/ZRIF key
# files, and the base URL apps.ingestion.api.get_ingestion_key serves them
# back from. The latter must be reachable from wherever the *download*
# pipeline actually runs (a celery-worker container), not just from the
# host — the Docker Compose service name, not localhost, hence the default.
NOPAYSTATION_KEYS_DIR=./data/nopaystation
NOPAYSTATION_KEYS_BASE_URL=http://django:8000

# Ingestion-time secrets (RetroAchievements catalog enrichment; NOT per-user credentials)
RA_API_USER=
RA_API_KEY=

# Production only (see config/settings/production.py)
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
